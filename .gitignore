# Sorties d'amnesia : donnees client, jamais commitees (un hook pre-commit les
# refuse aussi avec git add -f). Tout rapport ou bundle doit porter le prefixe
# amnesia-.
amnesia-report*
amnesia-bundle*
amnesia-out/
/reports/
*.amnesia.json

# Secrets
.env
.env.*
!.env.example

# Donnees brutes de test (exports reels, jamais commites)
tests/fixtures/**/raw/

# Systeme
.DS_Store
Thumbs.db
